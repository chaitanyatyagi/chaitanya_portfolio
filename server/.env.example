# =============================================================================
# DataDrill server configuration. Copy to server/.env and fill in.
# Every value is read once at startup by src/config.js (defaults shown there).
# =============================================================================

# --- Core ---------------------------------------------------------------------
NODE_ENV=development
PORT=3002
# Public URL of the web app (used in password-reset emails)
APP_URL=http://localhost:5173
# Required in production: long random string (≥ 32 chars) signing access tokens
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# --- Databases ------------------------------------------------------------------
# PostgreSQL — the platform's system of record (users, content, submissions, queue)
POSTGRES_URL=postgres://localhost:5432/datadrill
# MongoDB — legacy portfolio CMS only (blog, bookings, site content). Optional.
MONGO_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/portfolio
# (DATABASE= is still accepted as the old name for MONGO_URL)

# --- Scaling knobs (defaults are sensible; see docs/ARCHITECTURE.md §8) -----------
# API processes on this machine (default: one per CPU core in production)
# WEB_CONCURRENCY=4
# Postgres connections per API process. Keep processes × PG_POOL_MAX + 10 < max_connections.
# PG_POOL_MAX=10
# Grader lanes: jobs graded at once per track, and idle pre-warmed sandboxes.
# GRADER_SQL_CONCURRENCY=4
# GRADER_PYTHON_CONCURRENCY=4
# GRADER_PYSPARK_CONCURRENCY=3
# GRADER_WARM_SQL=1
# GRADER_WARM_PYTHON=2
# GRADER_WARM_PYSPARK=2
# GRADER_PANDAS_CONCURRENCY=3
# GRADER_SHELL_CONCURRENCY=2
# GRADER_WARM_PANDAS=1
# GRADER_WARM_SHELL=1
# GRADER_JOB_TIMEOUT_MS=20000
# Per-IP abuse limits — raise LIMIT_API_PER_MINUTE only for load tests from one machine.
# LIMIT_API_PER_MINUTE=600
# SUBMISSIONS_PER_MINUTE=10
# MAX_QUEUE_DEPTH=2000

# --- Email (password resets + booking notifications) -----------------------------
# Gmail App Password: https://myaccount.google.com/apppasswords (needs 2FA).
# Without SMTP, reset links are printed to the server log in development.
SMTP_USER=you@gmail.com
SMTP_PASS=1234

# --- Legacy CMS ---------------------------------------------------------------------
# Password for the old /admin content manager (portfolio CMS)
ADMIN_PASSWORD=change-me
# AI chatbot proxy (legacy portfolio feature)
ANTHROPIC_API_KEY=

# --- Local development only ---------------------------------------------------------
# A throwaway learner account that exists only in the local dev database:
#   email:    demo.learner@datadrill.test
#   password: drill-demo-8472
# Make yourself an admin:  npm run make-admin -- you@example.com

# --- Contests (docs §12) ------------------------------------------------------
# CONTEST_MAX_PLAYERS=10
# CONTEST_MAX_OPEN_PER_HOST=3
# CONTEST_MAX_PROBLEMS=8

